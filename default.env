# Copy this file to .env and customize it for your deployment.
# Variables ending in _TAG, _REPO, or _DOCKERFILE are build targets that
# are reset during updates when --refresh-targets is used.
ENV_VERSION=2

COMPOSE_FILE=pharos.yml:
NETWORK=mainnet
EXPECTED_CHAIN_ID=0x688

NODE_DOCKER_REPO=public.ecr.aws/k2g7b7g1/pharos
NODE_DOCKER_TAG=pharos_community_v0.12.2_f301031a_0422

# Leave empty for ./pharosd up to generate a random local value into .env.
# Set a managed secret value before production deployment if required.
CONSENSUS_KEY_PWD=

SNAPSHOT=https://snapshot.dplabs-internal.com/mainnet/mainnet-snapshot-2026-06-01-03.tar.gz
GENESIS_URL=https://raw.githubusercontent.com/PharosNetwork/resources/refs/heads/main/mainnet.genesis
VERSION_URL=https://raw.githubusercontent.com/PharosNetwork/resources/refs/heads/main/mainnet.version
PHAROS_CONF_URL=https://raw.githubusercontent.com/PharosNetwork/resources/refs/heads/main/conf/full.conf

RPC_PORT=18100
WS_PORT=18200
P2P_PORT=19000
PHAROS_RPC_PORT=20000

PUBLIC_RPC=https://rpc.pharos.xyz
BLOCK_LAG_THRESHOLD=5

DOCKER_EXT_NETWORK=traefik_default
DOMAIN=example.com
RPC_HOST=pharos
RPC_LB=pharos-lb
WS_HOST=pharosws
WS_LB=pharosws-lb

# Set a GitHub tag here if you pin this repo outside normal git workflows.
SCRIPT_TAG=
